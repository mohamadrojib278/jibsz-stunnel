#!/bin/bash
set -euo pipefail
VIP_DIR="${VIP_DIR:-/root/vip}"
if [ ! -d "$VIP_DIR" ]; then
    VIP_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." 2>/dev/null && pwd)"
fi
REPOS="https://raw.githubusercontent.com/mohamadrojib278/jibsz-stunnel/main/"

fetch_slowdns() {
    local name="$1"
    local dst="$2"
    mkdir -p "$(dirname "$dst")"
    if [ -f "${VIP_DIR}/slowdns/${name}" ]; then
        cp -f "${VIP_DIR}/slowdns/${name}" "$dst"
    elif [ -f "$(pwd)/${name}" ]; then
        cp -f "$(pwd)/${name}" "$dst"
    else
        wget -q -O "$dst" "${REPOS}slowdns/${name}" || curl -fsSL "${REPOS}slowdns/${name}" -o "$dst"
    fi
}

NS_DOMAIN=$(cat /etc/xray/dns 2>/dev/null || cat /root/nsdomain 2>/dev/null || cat /etc/slowdns/nsdomain 2>/dev/null || true)
if [[ -z "$NS_DOMAIN" ]]; then
    while true; do
        read -rp "Masukan NS SlowDNS: " NS_DOMAIN
        NS_DOMAIN=$(echo "$NS_DOMAIN" | tr -d '[:space:]')
        if [[ -n "$NS_DOMAIN" && "$NS_DOMAIN" == *.* ]]; then
            break
        fi
    done
    echo "$NS_DOMAIN" >/etc/xray/dns
    echo "$NS_DOMAIN" >/root/nsdomain
    echo "$NS_DOMAIN" >/etc/slowdns/nsdomain
fi

TMPDIR=$(mktemp -d)
cleanup() { rm -rf "$TMPDIR"; }
trap cleanup EXIT
mkdir -p /etc/slowdns
cd "$TMPDIR"

fetch_slowdns "dnstt-server" "dnstt-server"
chmod +x dnstt-server
./dnstt-server -gen-key -privkey-file server.key -pubkey-file server.pub
install -m 755 dnstt-server /etc/slowdns/dnstt-server
install -m 600 server.key /etc/slowdns/server.key
install -m 644 server.pub /etc/slowdns/server.pub

if systemctl is-active --quiet systemd-resolved 2>/dev/null || [ -f /etc/systemd/resolved.conf ]; then
    mkdir -p /etc/systemd/resolved.conf.d/
    cat >/etc/systemd/resolved.conf.d/noslowdnsconflict.conf <<'EOF'
[Resolve]
DNSStubListener=no
EOF
    sed -i 's/^#\?DNSStubListener=.*/DNSStubListener=no/' /etc/systemd/resolved.conf 2>/dev/null || true
    systemctl restart systemd-resolved >/dev/null 2>&1 || true
fi

fetch_slowdns "slowdns.service" "/etc/systemd/system/slowdns.service"
sed -i "s/xxxx/${NS_DOMAIN}/g" /etc/systemd/system/slowdns.service

iptables -I INPUT -p udp --dport 5300 -j ACCEPT 2>/dev/null || true
iptables -t nat -I PREROUTING -p udp --dport 53 -j REDIRECT --to-ports 5300 2>/dev/null || true

systemctl daemon-reload
systemctl enable --now slowdns.service || true

echo "SlowDNS NS: $NS_DOMAIN"
echo "Tambahkan NS record dns.${DOMAIN_PATH} di panel DNS Anda jika ingin memakai SlowDNS."
