#!/bin/bash

VIP_DIR="${VIP_DIR:-/root/vip}"
if [ ! -d "$VIP_DIR" ]; then
    VIP_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." 2>/dev/null && pwd)"
fi
REPO="https://raw.githubusercontent.com/mohamadrojib278/jibsz-stunnel/main/media/"

fetch_m() {
    local name="$1"
    local dst="$2"
    mkdir -p "$(dirname "$dst")"
    if [ -f "${VIP_DIR}/media/${name}" ]; then
        cp -f "${VIP_DIR}/media/${name}" "$dst"
    else
        wget -q -O "$dst" "${REPO}${name}" || curl -fsSL "${REPO}${name}" -o "$dst"
    fi
}
clear
echo -e " -------------------------"
echo -e "    Fix Haproxy & Nginx            "
echo -e " ------------------------- "
echo -e ""
echo -e ""
read -p " Masukin Domainya : " -e domain

haproxy_cfg_file() {
    local v maj
    v=$(haproxy -v 2>/dev/null | head -n1 | awk '{print $3}')
    maj="${v%%.*}"
    if [[ "$maj" =~ ^[0-9]+$ ]] && [ "$maj" -lt 2 ]; then
        echo "haproxy-1.8.cfg"
    else
        echo "haproxy.cfg"
    fi
}

rm -fr /etc/xray/domain
echo "${domain}" > /etc/xray/domain
systemctl stop haproxy
systemctl stop nginx
fetch_m "$(haproxy_cfg_file)" "/etc/haproxy/haproxy.cfg" >/dev/null 2>&1
fetch_m "xray.conf" "/etc/nginx/conf.d/xray.conf" >/dev/null 2>&1
sed -i "s/xxx/${domain}/g" /etc/haproxy/haproxy.cfg
sed -i "s/xxx/${domain}/g" /etc/nginx/conf.d/xray.conf
fetch_m "nginx.conf" "/etc/nginx/nginx.conf"

cat /etc/xray/xray.crt /etc/xray/xray.key | tee /etc/haproxy/hap.pem

systemctl restart nginx
systemctl restart haproxy
