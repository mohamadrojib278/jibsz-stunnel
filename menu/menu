#!/bin/bash
R="\e[1;31m"
G="\e[92;1m"
Y="\e[33m"
B="\e[34m"
C="\e[36m"
M="\e[35m"
W="\e[37;1m"
NC="\e[0m"
clear
Y="\033[1;33m"
BGX="\033[42m"
z="\033[95;1m"
f="\033[1;97;41m"
gray="\e[1;30m"
Blue="\033[0;34m"
purple="\033[1;95m"
YELL="\033[0;32m"
CY="\033[0;34m"
p="\033[0;37m"

COLOR_CONF="/etc/jibsz-stunnel/menu-color.conf"
if [ -f "$COLOR_CONF" ]; then
    . "$COLOR_CONF"
fi
clear
IPVPS=$(curl -s --max-time 3 ipv4.icanhazip.com || hostname -I | awk '{print $1}')
domain=$(cat /etc/xray/domain 2>/dev/null || echo "-")
LOADCPU=$(printf '%-0.00001s' "$(top -bn1 | awk '/Cpu/ { cpu = "" 100 - $8 "%" }; END { print cpu }')")
MODEL=$(cat /etc/os-release | grep -w PRETTY_NAME | head -n1 | sed 's/=//g' | sed 's/"//g' | sed 's/PRETTY_NAME//g')
CORE=$(printf '%-1s' "$(grep -c cpu[0-9] /proc/stat)")
DATEVPS=$(date +'%d-%m-%Y')
TIMEZONE=$(printf '%(%H-%M-%S)T')
SERONLINE=$(uptime -p | cut -d " " -f 2-10000)

tram=$( free -m | awk 'NR==2 {print $2}' )
uram=$( free -m | awk 'NR==2 {print $3}' )
is_active() { systemctl is-active --quiet "$1" 2>/dev/null; }
status_on_error() { if is_active "$1"; then echo "${G}ON"; else echo "${R}ERROR"; fi; }
status_any_on_error() {
    for svc in "$@"; do
        if is_active "$svc"; then echo "${G}ON"; return; fi
    done
    echo "${R}ERROR"
}

status_ssh=$(status_any_on_error ssh sshd)
status_dropbear=$(status_on_error dropbear)
status_haproxy=$(status_on_error haproxy)
status_xray=$(status_on_error xray)
status_nginx=$(status_on_error nginx)
status_ws_epro=$(status_on_error ws)
status_cf=$(status_any_on_error jibsz-cloudflared cloudflared)
vlx=$(grep -c -E "^#& " "/etc/xray/config.json" 2>/dev/null || echo 0)
let vla=$vlx/2
vmc=$(grep -c -E "^### " "/etc/xray/config.json" 2>/dev/null || echo 0)
let vma=$vmc/2
ssh1="$(awk -F: '$3 >= 1000 && $1 != "nobody" && $1 != "jibszbot" {print $1}' /etc/passwd | wc -l)"
trx=$(grep -c -E "^#! " "/etc/xray/config.json" 2>/dev/null || echo 0)
let trb=$trx/2
ssx=$(grep -c -E "^#!# " "/etc/xray/config.json" 2>/dev/null || echo 0)
let ssa=$ssx/2

clear
echo -e ""
echo -e "\E[44;1;39m ꧁࿇ JIBSZ STUNNEL - VPS NAT & CLOUDFLARE ARGO ࿇꧂ \E[0m"
echo -e ""
echo -e " ${NC} ╭════════════════════════════════════════════════════════════╮"
echo -e " ${NC} │\e[1;97;101m        Welcome to Jibsz Stunnel Multiport (NAT Ready)      \e[0m${NC}│"
echo -e " ${NC} ╰════════════════════════════════════════════════════════════╯"
echo -e " ${NC} ╭════════════════════════════════════════════════════════════╮"
echo -e " ${NC} │$R ● ${C}SYSTEM OS ${YELL}   = \033[0;37m$MODEL${NC}"
echo -e " ${NC} │$R ● ${C}SYSTEM CORE ${YELL} = \033[0;37m$CORE${NC}"
echo -e " ${NC} │$R ● ${C}SERVER RAM ${YELL}  = \033[0;37m$tram / $uram MB $NC"
echo -e " ${NC} │$R ● ${C}LOADCPU ${YELL}     = \033[0;37m$LOADCPU ℅$NC"
echo -e " ${NC} │$R ● ${C}DATE ${YELL}        = \033[0;37m$DATEVPS${NC}"
echo -e " ${NC} │$R ● ${C}TIME ${YELL}        = \033[0;37m$TIMEZONE${NC}"
echo -e " ${NC} │$R ● ${C}UPTIME ${YELL}      = \033[0;37m$SERONLINE${NC}"
echo -e " ${NC} │$R ● ${C}IP VPS ${YELL}      = \033[0;37m$IPVPS${NC}"
echo -e " ${NC} │$R ● ${C}CF DOMAIN ${YELL}   = \033[0;37m$domain${NC}"
echo -e " ${NC} ╰════════════════════════════════════════════════════════════╯$NC"
echo -e " \033[0;37m                  >>> INFORMATION ACCOUNT <<< "
echo -e " ${NC}         ═════════════════════════════════════════════${NC}"
echo -e "               ${G} SSH/OPENVPN/WS   $YELL=\033[0;37m $ssh1  ${YELL}$a"
echo -e "               ${G} VMESS/WS/GRPC    $YELL=\033[0;37m $vma  ${YELL}$a"
echo -e "               ${G} VLESS/WS/GRPC    $YELL=\033[0;37m $vla  ${YELL}$a"
echo -e "               ${G} TROJAN/WS/GRPC   $YELL=\033[0;37m $trb  ${YELL}$a"
echo -e "               ${G} SHADOW/WS/GRPC   $YELL=\033[0;37m $ssa  ${YELL}$a"
echo -e " ${NC}         ═════════════════════════════════════════════${NC}"
echo -e " ${p}        >>> Jibsz Stunnel by @admj1btnl (Cloudflare Tunnel) <<<${NC}"
echo -e " ${NC} ╭═══════════════════╮╭═══════════════════╮╭══════════════════╮$NC"
echo -e " ${NC} │${p} SSH     $status_ssh   ${p}    NGINX $status_nginx ${p}    HAPROXY  $status_haproxy    ${NC}"
echo -e " ${NC} │${p} WS-ePro $status_ws_epro    ${p} CF TUNNEL $status_cf ${p}    XRAY  $status_xray ${p}    DROPBEAR $status_dropbear    ${NC}"
echo -e " ${NC} ╰═══════════════════╯╰═══════════════════╯╰══════════════════╯$NC"
echo -e " ${NC} ╭════════════════════════════════════════════════════════════╮"
printf " ${NC} │ %b%-18s${NC}│ %b%-18s${NC}│ %b%-19s${NC}│\n" "$p" "[01] SSH MENU"      "$p" "[08] BCKP/RSTR"    "$p" "[16] CHANGE DOMAIN"
printf " ${NC} │ %b%-18s${NC}│ %b%-18s${NC}│ %b%-19s${NC}│\n" "$p" "[02] VMESS MENU"    "$p" "[09] GOTOP X RAM"  "$p" "[17] FIX CRT DOMAIN"
printf " ${NC} │ %b%-18s${NC}│ %b%-18s${NC}│ %b%-19s${NC}│\n" "$p" "[03] VLESS MENU"    "$p" "[10] RESTART ALL"  "$p" "[18] CHANGE BANNER"
printf " ${NC} │ %b%-18s${NC}│ %b%-18s${NC}│ %b%-19s${NC}│\n" "$p" "[04] TROJAN MENU"   "$p" "[11] COLOUR"       "$p" "[19] RESTART BANNER"
printf " ${NC} │ %b%-18s${NC}│ %b%-18s${NC}│ %b%-19s${NC}│\n" "$p" "[05] CF TUNNEL/BOT" "$p" "[12] UPDATE MENU"  "$p" "[20] SPEEDTEST"
printf " ${NC} │ %b%-18s${NC}│ %b%-18s${NC}│ %b%-19s${NC}│\n" "$p" "[06] SS - LIBEV"    "$p" "[13] RUNNING"      "$p" "[21] EKSTRAK MENU"
printf " ${NC} │ %b%-18s${NC}│ %b%-18s${NC}│ %b%-19s${NC}│\n" "$p" "[07] INSTALL UDP"   "$p" "[14] INFO PORT"    "$p" ""
echo -e " ${NC} ╰════════════════════════════════════════════════════════════╯"
echo -e " ${NC} ╭════════════════════════════════════════════════════════════╮"
echo -e " ${NC} │\033[0;37m Script Version $YELL= \033[0;37m JIBSZ STUNNEL NAT EDITION (LIFETIME) "
echo -e " ${NC} ╰════════════════════════════════════════════════════════════╯\033[0;37m"
echo -e " "
read -p "  Options [ 1 - 21 ] ❱❱❱ " opt
echo -e ""
case $opt in
1 | 01) clear ; m-sshws ;;
2 | 02) clear ; m-vmess ;;
3 | 03) clear ; m-vless ;;
4 | 04) clear ; m-trojan ;;
5 | 05) clear ; m-cf ;;
6 | 06) clear ; m-ssws ;;
7 | 07) clear ; udepe ;;
8 | 08) clear ; menu-backup ;;
9 | 09) clear ; gotop ;;
10) clear ; restart ;;
11) clear ; change-color ;;
12) clear ; update-menu ;;
13) clear ; run ;;
14) clear ; prot ;;
16) clear ; addhost ;;
17) clear ; fixcert ;;
18) clear ; nano /etc/issue.net ;;
19) clear ; /etc/init.d/dropbear restart ;;
20) clear ; speedtest ;;
21) clear ; m-system ;;
0 | 00) exit ;;
x) menu ;;
*) clear ; menu ;;
esac
